[importlinter]
root_packages =
    app

# Contracts start permissive (only domain is declared) and tighten as each
# layer lands. This ensures we enforce the dependency rule incrementally.
[importlinter:contract:1]
name = Domain packages must exist
type = forbidden
source_modules =
    app.domain
forbidden_modules =
    # To be tightened in Step 8: no fastapi, sqlalchemy, celery, openai, httpx, pymupdf, redis, tiktoken, pydantic_settings
