[importlinter]
root_packages =
    app
include_external_packages = True

# Domain layer: no external dependencies (stdlib + app.domain only)
[importlinter:contract:1]
name = Domain layer isolation
type = forbidden
source_modules =
    app.domain
forbidden_modules =
    fastapi
    sqlalchemy
    celery
    openai
    httpx
    pymupdf
    redis
    tiktoken
    pydantic_settings
