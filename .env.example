# Copy to .env. Values here are HOST-facing: they are what `uv run pytest`,
# `uv run alembic` and any tool running outside Docker should use.
# docker-compose.yml overrides DATABASE_URL / REDIS_URL / CELERY_* for the
# `api` and `worker` services to use the in-network hostnames (postgres, redis).

# --- Postgres (consumed by the postgres service and by the app) ---
POSTGRES_USER=bookchat
POSTGRES_PASSWORD=bookchat
POSTGRES_DB=bookchat

DATABASE_URL=postgresql+asyncpg://bookchat:bookchat@localhost:5432/bookchat

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- App ---
# Unset on the host: defaults to <repo root>/uploads.
# The api/worker containers override it to /data/uploads (a named volume).
# UPLOAD_DIR=
MAX_UPLOAD_MB=50
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- LLM: chat, query rewriting and re-ranking ---
# One OpenAI-compatible endpoint serves all three. The default is Groq's free
# tier (key from console.groq.com); the HF router, OpenAI itself or a local
# vLLM work by changing LLM_BASE_URL alone — no code change.
# Leave LLM_TOKEN empty and the system falls back to the deterministic Fake*
# adapters: the app still runs end to end, but answers are canned.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TOKEN=
CHAT_MODEL=openai/gpt-oss-120b
CHAT_REWRITE_MODEL=openai/gpt-oss-20b
RERANK_MODEL=openai/gpt-oss-120b

# --- Embeddings: local Ollama, free ---
# nomic-embed-text is 768-wide, which is what chunks.embedding holds
# (migration 0004). Changing the model means another migration.
EMBEDDING_DIMENSIONS=768
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Containers get OLLAMA_BASE_URL from docker-compose.yml (host.docker.internal);
# host tooling uses the localhost default.
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_BATCH_SIZE=100

# --- Ingestion (defaults shown; override only to tune) ---
# CHUNK_TARGET_TOKENS=600
# CHUNK_OVERLAP_RATIO=0.15

# --- Retrieval (defaults shown; override only to tune) ---
# RETRIEVAL_TOP_K=30
# RERANK_TOP_N=8
# RERANK_MIN_SCORE=5
# RERANK_MAX_TOKENS=2048

# --- Chat (defaults shown; override only to tune) ---
# CHAT_MAX_TOKENS=2048
# CHAT_HISTORY_TURNS=6
# CHAT_HEARTBEAT_SECONDS=15.0
