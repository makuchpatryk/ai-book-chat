# Copy to .env. Values here are HOST-facing: they are what `uv run pytest`,
# `uv run alembic` and any tool running outside Docker should use.
# docker-compose.yml overrides DATABASE_URL / REDIS_URL / CELERY_* for the
# `api` and `worker` services to use the in-network hostnames (postgres, redis).

# --- Postgres (consumed by the postgres service and by the app) ---
POSTGRES_USER=bookchat
POSTGRES_PASSWORD=bookchat
POSTGRES_DB=bookchat

DATABASE_URL=postgresql+asyncpg://bookchat:bookchat@localhost:5432/bookchat

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- App ---
# Unset on the host: defaults to <repo root>/uploads.
# The api/worker containers override it to /data/uploads (a named volume).
# UPLOAD_DIR=
MAX_UPLOAD_MB=50
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Providers ---
# OPENAI_API_KEY drives ingestion embeddings. Leave it empty and the pipeline
# falls back to a deterministic fake embedder (fine for tests, useless for search).
OPENAI_API_KEY=
# LLM_API_KEY used for re-ranking and chat generation (shared across all LLM providers).
# Leave empty and the system falls back to FakeReranker (term overlap, offline).
LLM_API_KEY=
# Kept for backwards compatibility; if set, used instead of LLM_API_KEY for Anthropic.
ANTHROPIC_API_KEY=
# HF_TOKEN drives the default provider (Hugging Face Inference Providers). Falls
# back to LLM_API_KEY when empty, so a single-key deployment keeps working.
HF_TOKEN=
# Router base URL — override only to pin a different OpenAI-compatible gateway.
# HF_BASE_URL=https://router.huggingface.co/v1
# Bill usage to an organisation instead of the token owner (X-HF-Bill-To).
# HF_BILL_TO=

# --- Ingestion (defaults shown; override only to tune) ---
# Embedding backend: openai | huggingface. Stays on openai: chunks.embedding is a
# fixed Vector(1536) column, so switching needs a migration and a re-ingest first.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BATCH_SIZE=100
# CHUNK_TARGET_TOKENS=600
# CHUNK_OVERLAP_RATIO=0.15
# Used only when EMBEDDING_PROVIDER=huggingface (1024 dims — see the note above).
# HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
# HF_EMBEDDING_QUERY_PREFIX="query: "
# HF_EMBEDDING_PASSAGE_PREFIX="passage: "

# --- Retrieval (defaults shown; override only to tune) ---
# LLM provider for re-ranking: huggingface | anthropic | mistral | ollama
# RERANK_PROVIDER=huggingface
# Model name depends on provider:
#   huggingface: openai/gpt-oss-120b:cheapest, meta-llama/Llama-3.3-70B-Instruct:groq
#   anthropic: claude-haiku-4-5, claude-3-5-sonnet-20241022
#   mistral: mistral-large-latest
#   ollama: mistral, neural-chat (must be pulled locally)
# RERANK_MODEL=openai/gpt-oss-120b:cheapest
# RERANK_TOP_K=30
# RERANK_TOP_N=8
# RERANK_MIN_SCORE=5
# RERANK_MAX_TOKENS=2048
# For Ollama (local LLM): HTTP endpoint to Ollama server
# OLLAMA_BASE_URL=http://localhost:11434

# --- Chat (defaults shown; override only to tune) ---
# LLM provider for generation and query rewriting: huggingface | anthropic | mistral | ollama
# CHAT_PROVIDER=huggingface
# On huggingface, the suffix after the model id selects a routing policy:
#   :cheapest lowest price per output token, :fastest the router default,
#   :preferred the account's provider order, or pin one (:groq, :together).
# CHAT_MODEL=openai/gpt-oss-120b:cheapest
# CHAT_REWRITE_MODEL=openai/gpt-oss-20b:cheapest
# CHAT_MAX_TOKENS=2048
# CHAT_HISTORY_TURNS=6
# CHAT_HEARTBEAT_SECONDS=15.0
